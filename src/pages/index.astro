---
import BaseLayout from '../layouts/BaseLayout.astro';
import ClosingDemo from '../components/ClosingDemo.astro';
import Credibility from '../components/Credibility.astro';
import CurrentStage from '../components/CurrentStage.astro';
import FragmentedExperience from '../components/FragmentedExperience.astro';
import Founders from '../components/Founders.astro';
import Hero from '../components/Hero.astro';
import IntegratedSolution from '../components/IntegratedSolution.astro';
import ProductPillars from '../components/ProductPillars.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../content/site';
---

<BaseLayout title={site.title}>
  <Hero />
  <FragmentedExperience />
  <IntegratedSolution />
  <ProductPillars />
  <ProductShowcase />
  <CurrentStage />
  <Credibility />
  <Founders />
  <ClosingDemo />
  <SiteFooter />
</BaseLayout>
