---
import BaseLayout from '../layouts/BaseLayout.astro';
import Credibility from '../components/Credibility.astro';
import Founders from '../components/Founders.astro';
import Hero from '../components/Hero.astro';
import HowItWorks from '../components/HowItWorks.astro';
import ProductExperience from '../components/ProductExperience.astro';
import ProductProof from '../components/ProductProof.astro';
import SiteFooter from '../components/SiteFooter.astro';
import WhyTradeHub from '../components/WhyTradeHub.astro';
import { contact, site } from '../content/site';
---

<BaseLayout title={site.title} pageClass="landing-page">
  <Hero />
  <ProductProof />
  <ProductExperience />
  <HowItWorks />
  <WhyTradeHub />
  <Credibility />
  <Founders />
  <section id="contact" class="contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <div class="contact-copy">
        <p class="section-label">{contact.label}</p>
        <h2 id="contact-title">{contact.heading}</h2>
        <p class="contact-introduction">{contact.introduction}</p>
        <a class="contact-email" href={`mailto:${site.contactEmail}`}>
          {site.contactEmail}
        </a>
      </div>
      <form
        class="contact-form"
        method="dialog"
        data-contact-email={site.contactEmail}
        data-contact-form
      >
        <div class="contact-fields">
          <label>
            {contact.nameLabel}
            <input name="name" autocomplete="name" required maxlength="100" />
          </label>
          <label>
            {contact.emailLabel}
            <input
              name="email"
              type="email"
              autocomplete="email"
              required
              maxlength="254"
            />
          </label>
        </div>
        <label>
          {contact.messageLabel}
          <textarea
            name="message"
            rows="4"
            required
            maxlength="3000"
          ></textarea>
        </label>
        <div class="contact-actions">
          <button
            type="submit"
            class="button button-signal"
            aria-describedby="contact-note"
            disabled
            data-contact-submit
          >
            {contact.action}
          </button>
          <p id="contact-note">{contact.note}</p>
          <noscript>
            <p>
              Enable JavaScript to prepare a draft, or use the email link above.
            </p>
          </noscript>
        </div>
      </form>
    </div>
  </section>
  <SiteFooter />
  <script>
    import '../scripts/landing';
  </script>
</BaseLayout>
