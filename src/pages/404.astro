---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page not found — TradeHub"
  description="The requested TradeHub page could not be found."
  robots="noindex, nofollow"
  showHeader={false}
  pageClass="not-found-page"
>
  <section class="not-found" aria-labelledby="not-found-title">
    <div class="container not-found-inner">
      <p class="section-label">404 error</p>
      <h1 id="not-found-title">This page does not exist.</h1>
      <p>
        The address may have changed, or the page may no longer be available.
      </p>
      <a class="button button-primary" href="/">
        Return to TradeHub
      </a>
    </div>
  </section>
</BaseLayout>
