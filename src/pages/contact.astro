---
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../content/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact TradeHub"
  description="Contact the TradeHub team by email."
  pageClass="contact-page"
>
  <section class="contact" aria-labelledby="contact-title">
    <div class="container contact-inner">
      <p class="section-label">Contact</p>
      <h1 id="contact-title">Let’s talk.</h1>
      <p class="contact-introduction">
        For questions about TradeHub, product feedback, or partnership
        enquiries, contact our team by email.
      </p>
      <a class="contact-email" href={`mailto:${site.contactEmail}`}>
        {site.contactEmail}
      </a>
    </div>
  </section>
  <SiteFooter />
</BaseLayout>
