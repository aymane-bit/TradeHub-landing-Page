---
import BaseLayout from '../layouts/BaseLayout.astro';
import { stocks } from '../demo/data';
import '../styles/demo.css';
import '../styles/tour.css';

const money = (value: number) =>
  `${value.toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 })} MAD`;
const movers = [...stocks]
  .sort((a, b) => Math.abs(b.change) - Math.abs(a.change))
  .slice(0, 5);
---

<BaseLayout title="TradeHub isolated demo" showHeader={false}>
  <div class="demo-app" data-demo-app>
    <aside class="demo-sidebar" aria-label="Demo navigation">
      <a class="demo-brand" href="/demo" aria-label="TradeHub demo overview">
        <span class="demo-brand-mark" aria-hidden="true">
          ▥
        </span>
        <span>
          Trade<span>Hub</span>
        </span>
      </a>
      <div class="demo-state-card">
        <strong>Demo environment</strong>
        <span>Synthetic market data and virtual funds only.</span>
      </div>
      <p class="demo-nav-label">Explore TradeHub</p>
      <nav class="demo-nav">
        <button class="is-active" type="button" data-demo-view="dashboard">
          <span aria-hidden="true">▦</span>Overview
        </button>
        <button type="button" data-demo-view="market" data-tour-id="nav-market">
          <span aria-hidden="true">⌁</span>Market
        </button>
        <button
          type="button"
          data-demo-view="portfolio"
          data-tour-id="nav-portfolio"
        >
          <span aria-hidden="true">▤</span>Portfolio
        </button>
        <button
          type="button"
          data-demo-view="transactions"
          data-tour-id="nav-transactions"
        >
          <span aria-hidden="true">⇅</span>Transactions
        </button>
        <button
          type="button"
          data-demo-view="watchlist"
          data-tour-id="nav-watchlist"
        >
          <span aria-hidden="true">☆</span>Watchlist
        </button>
        <button
          type="button"
          data-demo-view="community"
          data-tour-id="nav-community"
        >
          <span aria-hidden="true">▧</span>Community
        </button>
        <button
          type="button"
          data-demo-view="profile"
          data-tour-id="nav-profile"
        >
          <span aria-hidden="true">♙</span>Profile
        </button>
      </nav>
      <div class="demo-sidebar-footer">
        <button class="demo-outline-button" type="button" data-demo-reset>
          ↻ Reset demo
        </button>
        <button class="demo-outline-button" type="button" data-tour-restart>
          ? Guided tour
        </button>
        <a href="/">← Exit demo</a>
      </div>
    </aside>

    <div class="demo-workspace">
      <header class="demo-topbar">
        <a
          class="demo-mobile-brand"
          href="/demo"
          aria-label="TradeHub demo overview"
        >
          <span class="demo-brand-mark" aria-hidden="true">
            ▥
          </span>
          <strong>TradeHub</strong>
        </a>
        <div class="demo-topbar-title">
          <span>Public product preview</span>
          <strong>Practice workspace</strong>
        </div>
        <div class="demo-topbar-actions">
          <strong class="demo-pill">Demo</strong>
          <button
            class="demo-icon-button"
            type="button"
            data-tour-restart
            aria-label="Start guided tour"
          >
            ?
          </button>
          <button
            class="demo-icon-button"
            type="button"
            data-demo-reset
            aria-label="Reset demo"
          >
            ↻
          </button>
          <a
            class="demo-icon-button"
            href="/"
            aria-label="Back to the TradeHub website"
          >
            ←
          </a>
        </div>
      </header>
      <p class="demo-disclaimer">
        Simulated experience · Data is illustrative and does not represent live
        market information or real financial activity.
      </p>

      <div class="demo-scroll">
        <section
          class="demo-panel"
          data-demo-panel="dashboard"
          aria-labelledby="dashboard-title"
        >
          <div class="demo-heading">
            <h1 id="dashboard-title">Market overview</h1>
            <p>
              Explore a deterministic TradeHub workspace using virtual funds and
              synthetic market data.
            </p>
          </div>
          <div class="demo-metrics" data-tour-id="dashboard-summary">
            <article>
              <span>Portfolio value</span>
              <strong data-total-value>{money(180797.5)}</strong>
              <i aria-hidden="true">▤</i>
            </article>
            <article>
              <span>Portfolio return</span>
              <strong class="is-positive" data-return>
                +3.14%
              </strong>
              <i aria-hidden="true">↗</i>
            </article>
            <article>
              <span>Cash balance</span>
              <strong data-cash>{money(82450)}</strong>
              <i aria-hidden="true">◉</i>
            </article>
            <article>
              <span>Market pulse</span>
              <strong class="is-positive">+0.20%</strong>
              <i aria-hidden="true">↗</i>
            </article>
          </div>
          <div class="demo-dashboard-grid">
            <article class="demo-card demo-chart-card">
              <div class="demo-card-header">
                <div>
                  <h2>Portfolio trajectory</h2>
                  <p>Illustrative 30-day practice performance</p>
                </div>
                <span class="demo-positive-pill">Virtual only</span>
              </div>
              <svg
                class="demo-line-chart"
                viewBox="0 0 620 220"
                role="img"
                aria-label="Illustrative portfolio trajectory"
              >
                <path
                  d="M8 174 C55 166 74 171 112 148 S170 151 210 126 S272 112 311 116 S371 92 412 95 S474 78 510 67 S560 68 610 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4"
                  vector-effect="non-scaling-stroke"
                ></path>
              </svg>
              <div class="demo-chart-summary">
                <span>
                  Holdings<strong data-holdings-value>{money(98347.5)}</strong>
                </span>
                <span>
                  Unrealized P/L
                  <strong class="is-positive" data-pnl>
                    {money(2992.5)}
                  </strong>
                </span>
              </div>
            </article>
            <article class="demo-card demo-movers">
              <div class="demo-card-header">
                <h2>Top movers</h2>
                <button type="button" data-demo-view="market">
                  View market
                </button>
              </div>
              <div class="demo-mover-list">
                {movers.map((stock) => (
                  <button type="button" data-stock-id={stock.id}>
                    <span>
                      <strong>{stock.symbol}</strong>
                      <small>{stock.name}</small>
                    </span>
                    <span>
                      {money(stock.price)}
                      <small
                        class={
                          stock.change >= 0 ? 'is-positive' : 'is-negative'
                        }
                      >
                        {stock.change >= 0 ? '+' : ''}
                        {stock.change.toFixed(2)}%
                      </small>
                    </span>
                  </button>
                ))}
              </div>
            </article>
          </div>
        </section>

        <section
          class="demo-panel"
          data-demo-panel="market"
          aria-labelledby="market-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="market-title">Market board</h1>
            <p>
              Search and compare a reviewed synthetic Casablanca-market dataset.
            </p>
          </div>
          <label class="demo-search">
            <span class="sr-only">Search stocks</span>
            <span aria-hidden="true">⌕</span>
            <input
              type="search"
              placeholder="Search symbol, company, or sector"
              data-market-search
              data-tour-id="market-search"
            />
          </label>
          <div class="demo-table-card">
            <table>
              <thead>
                <tr>
                  <th>Symbol</th>
                  <th>Price</th>
                  <th>Change</th>
                  <th>Open</th>
                  <th>Volume</th>
                  <th>Sector</th>
                </tr>
              </thead>
              <tbody>
                {stocks.map((stock) => (
                  <tr
                    data-market-row
                    data-search={`${stock.symbol} ${stock.name} ${stock.sector}`.toLowerCase()}
                  >
                    <td>
                      <button
                        class="demo-market-symbol"
                        type="button"
                        data-stock-id={stock.id}
                        data-tour-id={
                          stock.id === 'dyt' ? 'market-result-dyt' : undefined
                        }
                      >
                        <strong>{stock.symbol}</strong>
                        <small>{stock.name}</small>
                      </button>
                    </td>
                    <td>{money(stock.price)}</td>
                    <td
                      class={stock.change >= 0 ? 'is-positive' : 'is-negative'}
                    >
                      {stock.change >= 0 ? '+' : ''}
                      {stock.change.toFixed(2)}%
                    </td>
                    <td>{money(stock.open)}</td>
                    <td>{stock.volume.toLocaleString()}</td>
                    <td>{stock.sector}</td>
                  </tr>
                ))}
              </tbody>
            </table>
            <p class="demo-empty" data-market-empty hidden>
              No synthetic symbols match your search.
            </p>
          </div>
        </section>

        <section
          class="demo-panel"
          data-demo-panel="stock"
          aria-labelledby="stock-title"
          hidden
        >
          <button
            class="demo-back-button"
            type="button"
            data-demo-view="market"
          >
            ← Back to market
          </button>
          <div class="demo-stock-heading" data-tour-id="stock-overview">
            <div>
              <span data-stock-symbol>CRS</span>
              <h1 id="stock-title" data-stock-name>
                Cartier Saada
              </h1>
              <p>
                <span data-stock-sector>Consumer goods</span> · Synthetic market
                fixture
              </p>
            </div>
            <div>
              <strong data-stock-price>{money(20)}</strong>
              <span class="is-positive" data-stock-change>
                +2.05%
              </span>
            </div>
          </div>
          <div class="demo-stock-grid">
            <article class="demo-card">
              <div class="demo-card-header">
                <div>
                  <h2>Price history</h2>
                  <p>Deterministic illustrative series</p>
                </div>
                <span class="demo-muted-pill">9 sessions</span>
              </div>
              <svg
                class="demo-line-chart demo-stock-chart"
                viewBox="0 0 620 220"
                role="img"
                aria-label="Illustrative stock price history"
              >
                <polyline
                  data-stock-line
                  points="0,180 78,160 155,132 232,146 310,104 388,80 465,48 542,62 620,30"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="4"
                  vector-effect="non-scaling-stroke"
                ></polyline>
              </svg>
              <div class="demo-stock-stats">
                <span>
                  Open<strong data-stock-open>19.60 MAD</strong>
                </span>
                <span>
                  High<strong data-stock-high>25.60 MAD</strong>
                </span>
                <span>
                  Low<strong data-stock-low>19.20 MAD</strong>
                </span>
                <span>
                  Volume<strong data-stock-volume>132,320</strong>
                </span>
              </div>
            </article>
            <article class="demo-card demo-trade-card">
              <div class="demo-trade-price">
                <span>Current synthetic price</span>
                <strong data-trade-price>{money(20)}</strong>
                <button
                  type="button"
                  data-watch-toggle
                  data-tour-id="watchlist-toggle"
                  aria-label="Add stock to watchlist"
                >
                  ☆
                </button>
              </div>
              <div class="demo-side-picker">
                <button
                  class="is-active"
                  type="button"
                  data-trade-side="buy"
                  data-tour-id="trade-buy"
                >
                  Buy
                </button>
                <button
                  type="button"
                  data-trade-side="sell"
                  data-tour-id="trade-sell"
                >
                  Sell
                </button>
              </div>
              <label for="demo-quantity">Quantity</label>
              <input
                id="demo-quantity"
                type="number"
                min="1"
                value="1"
                data-trade-quantity
                data-tour-id="trade-quantity"
              />
              <div class="demo-trade-meta">
                <span>
                  Held: <strong data-held>900</strong>
                </span>
                <span>
                  Estimated: <strong data-estimate>{money(20)}</strong>
                </span>
              </div>
              <button
                class="demo-confirm"
                type="button"
                data-trade-confirm
                data-tour-id="trade-confirm"
              >
                Confirm virtual buy
              </button>
              <p
                class="demo-trade-message"
                data-trade-message
                aria-live="polite"
              ></p>
              <p class="demo-fineprint">
                Orders execute instantly against fixed demo prices and never
                leave this browser.
              </p>
            </article>
          </div>
        </section>

        <section
          class="demo-panel"
          data-demo-panel="portfolio"
          aria-labelledby="portfolio-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="portfolio-title">Portfolio</h1>
            <p>
              Inspect your isolated virtual holdings and simulated performance.
            </p>
          </div>
          <div class="demo-metrics" data-tour-id="portfolio-summary">
            <article>
              <span>Total value</span>
              <strong data-portfolio-total></strong>
              <i>▤</i>
            </article>
            <article>
              <span>Cash balance</span>
              <strong data-portfolio-cash></strong>
              <i>◉</i>
            </article>
            <article>
              <span>Holdings value</span>
              <strong data-portfolio-holdings></strong>
              <i>↗</i>
            </article>
            <article>
              <span>Unrealized P/L</span>
              <strong data-portfolio-pnl></strong>
              <i>↗</i>
            </article>
          </div>
          <div class="demo-table-card">
            <div class="demo-table-heading">
              <h2>Holdings</h2>
              <span data-position-count></span>
            </div>
            <table>
              <thead>
                <tr>
                  <th>Asset</th>
                  <th>Quantity</th>
                  <th>Average cost</th>
                  <th>Current value</th>
                  <th>P/L</th>
                  <th>
                    <span class="sr-only">Action</span>
                  </th>
                </tr>
              </thead>
              <tbody data-holdings-body></tbody>
            </table>
          </div>
        </section>
        <section
          class="demo-panel"
          data-demo-panel="transactions"
          aria-labelledby="transactions-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="transactions-title">Transactions</h1>
            <p>
              Every demo order stays in this browser and can be cleared with
              Reset demo.
            </p>
          </div>
          <div class="demo-table-card">
            <table>
              <thead>
                <tr>
                  <th>Date</th>
                  <th>Side</th>
                  <th>Symbol</th>
                  <th>Quantity</th>
                  <th>Price</th>
                  <th>Total</th>
                </tr>
              </thead>
              <tbody data-transactions-body></tbody>
            </table>
          </div>
        </section>
        <section
          class="demo-panel"
          data-demo-panel="watchlist"
          aria-labelledby="watchlist-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="watchlist-title">Watchlist</h1>
            <p>
              Keep a private browser-local shortlist of synthetic market
              fixtures.
            </p>
          </div>
          <div class="demo-watch-grid" data-watch-grid></div>
          <div class="demo-card demo-empty-state" data-watch-empty hidden>
            <span>☆</span>
            <p>Your demo watchlist is empty.</p>
            <button type="button" data-demo-view="market">
              Browse the market
            </button>
          </div>
        </section>
        <section
          class="demo-panel"
          data-demo-panel="community"
          aria-labelledby="community-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="community-title">Community</h1>
            <p>
              Share practice notes and explore a fictional investor community.
            </p>
          </div>
          <div class="demo-info">
            <strong>Social simulation.</strong> Every profile, post, reaction,
            and follow is fictional and stays in this browser.
          </div>
          <div class="demo-social-layout">
            <div class="demo-social-main">
              <form class="demo-card demo-composer" data-social-composer>
                <div class="demo-author">
                  <span class="demo-avatar-small">DV</span>
                  <div>
                    <strong>Demo Visitor</strong>
                    <small>Posting to the fictional demo feed</small>
                  </div>
                </div>
                <label for="demo-post-body">Share a practice-market note</label>
                <textarea
                  id="demo-post-body"
                  data-social-input
                  maxlength="240"
                  rows="3"
                  placeholder="What are you learning from the synthetic market?"
                ></textarea>
                <div class="demo-composer-footer">
                  <label>
                    <span class="sr-only">Post topic</span>
                    <select data-social-topic>
                      <option value="Market">Market</option>
                      <option value="Strategy">Strategy</option>
                      <option value="Learning">Learning</option>
                    </select>
                  </label>
                  <span>
                    <span data-social-count>0</span>/240
                  </span>
                  <button type="submit">Publish demo post</button>
                </div>
                <p
                  class="demo-form-message"
                  data-social-message
                  aria-live="polite"
                ></p>
              </form>

              <div
                class="demo-feed-toolbar"
                aria-label="Filter community posts"
              >
                <button
                  class="is-active"
                  type="button"
                  data-social-filter="All"
                >
                  All
                </button>
                <button type="button" data-social-filter="Market">
                  Market
                </button>
                <button type="button" data-social-filter="Strategy">
                  Strategy
                </button>
                <button type="button" data-social-filter="Learning">
                  Learning
                </button>
              </div>
              <div class="demo-feed" data-social-feed></div>
              <div class="demo-card demo-empty-state" data-social-empty hidden>
                <span>◇</span>
                <p>No fictional posts match this topic yet.</p>
                <button type="button" data-social-filter="All">
                  Show all posts
                </button>
              </div>
            </div>

            <aside class="demo-social-rail" aria-label="Community discovery">
              <section class="demo-card demo-people-card">
                <div class="demo-card-header">
                  <div>
                    <h2>People to follow</h2>
                    <p>Fictional demo profiles</p>
                  </div>
                </div>
                <div data-social-people></div>
              </section>
              <section class="demo-card demo-trending-card">
                <div class="demo-card-header">
                  <div>
                    <h2>Discussed today</h2>
                    <p>Synthetic symbols in the feed</p>
                  </div>
                </div>
                <button type="button" data-stock-id="reb">
                  <span>REB</span>
                  <small>5 fictional posts</small>
                </button>
                <button type="button" data-stock-id="afi">
                  <span>AFI</span>
                  <small>3 fictional posts</small>
                </button>
                <button type="button" data-stock-id="dyt">
                  <span>DYT</span>
                  <small>2 fictional posts</small>
                </button>
              </section>
            </aside>
          </div>
        </section>
        <section
          class="demo-panel"
          data-demo-panel="profile"
          aria-labelledby="profile-title"
          hidden
        >
          <div class="demo-heading">
            <h1 id="profile-title">Demo profile</h1>
            <p>
              A temporary fictional identity created automatically for this
              browser.
            </p>
          </div>
          <div class="demo-profile-grid">
            <article class="demo-card demo-profile-card">
              <span class="demo-avatar">DV</span>
              <h2>Demo Visitor</h2>
              <p>No email or registration required</p>
              <strong>◇ Isolated session</strong>
              <small>
                Session <span data-session-id></span>
              </small>
            </article>
            <div>
              <div class="demo-metrics demo-profile-metrics">
                <article>
                  <span>Virtual portfolio</span>
                  <strong data-profile-total></strong>
                </article>
                <article>
                  <span>Virtual P/L</span>
                  <strong data-profile-pnl></strong>
                </article>
                <article>
                  <span>Practice orders</span>
                  <strong data-profile-orders></strong>
                </article>
              </div>
              <article class="demo-card demo-protection">
                <h2>How this demo protects you</h2>
                <ul>
                  <li>
                    No account, email address, or personal details are
                    requested.
                  </li>
                  <li>Portfolio changes are stored only in this browser.</li>
                  <li>
                    The demo has no connection to TradeHub APIs, databases,
                    WebSockets, or market providers.
                  </li>
                  <li>
                    Reset demo immediately restores the reviewed synthetic
                    starting state.
                  </li>
                </ul>
              </article>
              <article
                class="demo-card demo-social-tools"
                data-tour-id="social-tools"
              >
                <h2>Wider social tools</h2>
                <p>Orientation preview for the broader TradeHub experience.</p>
                <div>
                  <span>Leaderboard</span>
                  <span>Notifications</span>
                  <span>Friends</span>
                  <span>Messages</span>
                </div>
                <small>
                  These destinations are not interactive in this isolated public
                  demo.
                </small>
              </article>
            </div>
          </div>
        </section>
      </div>
    </div>

    <nav class="demo-mobile-nav" aria-label="Demo mobile navigation">
      <button class="is-active" type="button" data-demo-view="dashboard">
        <span>▦</span>Home
      </button>
      <button type="button" data-demo-view="market" data-tour-id="nav-market">
        <span>⌁</span>Market
      </button>
      <button
        type="button"
        data-demo-view="portfolio"
        data-tour-id="nav-portfolio"
      >
        <span>▤</span>Portfolio
      </button>
      <button
        type="button"
        data-demo-view="transactions"
        data-tour-id="nav-transactions"
      >
        <span>⇅</span>Activity
      </button>
      <button
        type="button"
        data-demo-view="watchlist"
        data-tour-id="nav-watchlist"
      >
        <span>☆</span>Watchlist
      </button>
      <button
        type="button"
        data-demo-view="community"
        data-tour-id="nav-community"
      >
        <span>▧</span>Community
      </button>
      <button type="button" data-demo-view="profile" data-tour-id="nav-profile">
        <span>♙</span>Profile
      </button>
    </nav>
    <p class="demo-toast" data-demo-toast aria-live="polite" hidden></p>
    <div class="tour-overlay" data-tour-overlay hidden></div>
    <section
      class="tour-coachmark"
      data-tour-coachmark
      aria-live="polite"
      hidden
    >
      <div class="tour-coachmark-meta">
        <strong data-tour-chapter></strong>
        <span data-tour-progress></span>
      </div>
      <h2 data-tour-title></h2>
      <p data-tour-body></p>
      <p class="tour-error" data-tour-error hidden></p>
      <div class="tour-actions">
        <button type="button" data-tour-back>
          Back
        </button>
        <button type="button" data-tour-skip>
          Skip tour
        </button>
        <button class="tour-primary" type="button" data-tour-next>
          Next
        </button>
        <button class="tour-primary" type="button" data-tour-retry hidden>
          Retry
        </button>
      </div>
    </section>
    <div class="tour-modal-layer" data-tour-modal-layer hidden>
      <section
        class="tour-modal"
        role="dialog"
        aria-modal="true"
        aria-labelledby="tour-modal-title"
        aria-describedby="tour-modal-body"
        tabindex="-1"
      >
        <span class="demo-pill">Guided demo</span>
        <p class="tour-duration" data-tour-duration>
          About 5 minutes
        </p>
        <h2 id="tour-modal-title" data-tour-modal-title></h2>
        <p id="tour-modal-body" data-tour-modal-body></p>
        <p class="tour-simulation-note" data-tour-modal-note></p>
