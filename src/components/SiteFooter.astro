---
import { disclaimer, footer, site } from '../content/site';
---

<footer class="site-footer">
  <div class="disclaimer" aria-labelledby="disclaimer-title">
    <div class="container disclaimer-inner">
      <h2 id="disclaimer-title">Important information</h2>
      <p>{disclaimer}</p>
    </div>
  </div>
  <div class="container footer-main">
    <div class="footer-brand">
      <a class="wordmark wordmark-dark" href="/" aria-label={site.homeLabel}>
        <span class="brand-image">
          <img
            src="/brand/tradehub.webp"
            width="768"
            height="768"
            alt={site.name}
          />
        </span>
      </a>
      <p>{footer.descriptor}</p>
    </div>
    <nav aria-label={footer.navigationLabel}>
      <ul>
        {footer.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="footer-copyright">{footer.copyright}</p>
  </div>
</footer>
