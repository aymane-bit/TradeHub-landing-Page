---
import { disclaimer, footer, site } from '../content/site';
---

<div class="disclaimer" aria-label="Important information">
  <p class="container">{disclaimer}</p>
</div>
<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <a class="wordmark" href="#top" aria-label={site.homeLabel}>
        <span class="brand-image">
          <img
            src="/brand/tradehub.webp"
            width="768"
            height="768"
            alt={site.name}
          />
        </span>
      </a>
      <p>{footer.descriptor}</p>
    </div>
    <nav aria-label={footer.navigationLabel}>
      <ul class="footer-links">
        {footer.links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>
    <p class="footer-copyright">{footer.copyright}</p>
  </div>
</footer>
