---
import { whyTradeHub } from '../content/site';
---

<section class="section why-tradehub" id="about" aria-labelledby="about-title">
  <div class="container why-grid">
    <div class="why-statement reveal">
      <p class="section-label">{whyTradeHub.eyebrow}</p>
      <h2 id="about-title">{whyTradeHub.headline}</h2>
      <p>{whyTradeHub.copy}</p>
      <p class="why-support">{whyTradeHub.supportingCopy}</p>
      <ol class="product-flow" aria-label="TradeHub product flow">
        {whyTradeHub.flow.map((item, index) => (
          <li>
            <span>{String(index + 1).padStart(2, '0')}</span>
            {item}
          </li>
        ))}
      </ol>
    </div>
    <aside class="status-panel reveal" aria-labelledby="status-title">
      <p class="status-kicker">
        <span aria-hidden="true"></span>Product status
      </p>
      <h3 id="status-title">{whyTradeHub.status.heading}</h3>
      <p>{whyTradeHub.status.copy}</p>
      <ul>
        {whyTradeHub.status.labels.map((label) => (
          <li>{label}</li>
        ))}
      </ul>
    </aside>
  </div>
</section>
