---
import { closingDemo } from '../content/site';
---

<section class="section closing-demo" aria-labelledby="closing-title">
  <div class="container closing-grid reveal">
    <div>
      <p class="section-label section-label-dark">{closingDemo.eyebrow}</p>
      <h2 id="closing-title">{closingDemo.headline}</h2>
      <p class="closing-copy">{closingDemo.copy}</p>
      <div class="closing-actions">
        <a class="button button-light" href={closingDemo.primaryTarget}>
          {closingDemo.primaryAction}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-ghost-dark" href={closingDemo.secondaryTarget}>
          {closingDemo.secondaryAction}
          <span aria-hidden="true">↑</span>
        </a>
      </div>
      <p class="closing-note">{closingDemo.note}</p>
    </div>
    <div class="closing-fragment" aria-hidden="true">
      <span>TRADEHUB / DEMO</span>
      <div>
        <i></i>
        <i></i>
        <i></i>
        <i></i>
      </div>
      <strong>Explore. Practice. Understand.</strong>
    </div>
  </div>
</section>
