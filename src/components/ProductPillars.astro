---
import { productPillars } from '../content/site';
---

<section
  class="story-section pillars-section"
  id="platform"
  aria-labelledby="platform-title"
>
  <div class="container">
    <header class="section-introduction pillars-introduction">
      <p class="section-eyebrow">{productPillars.eyebrow}</p>
      <h2 id="platform-title">{productPillars.headline}</h2>
      <p class="section-lead">{productPillars.introduction}</p>
    </header>

    <ol class="pillar-grid">
      {productPillars.items.map((pillar) => (
        <li>
          <span class="item-number" aria-hidden="true">
            {pillar.number}
          </span>
          <h3>{pillar.title}</h3>
          <p>{pillar.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
