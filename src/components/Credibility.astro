---
import { credibility } from '../content/site';
---

<section
  class="section credibility"
  id="credibility"
  aria-labelledby="credibility-title"
>
  <div class="container credibility-grid">
    <header class="section-heading reveal">
      <p class="section-label">{credibility.eyebrow}</p>
      <h2 id="credibility-title">{credibility.headline}</h2>
    </header>
    <ol class="achievement-list">
      {credibility.achievements.map((achievement) => (
        <li class="reveal">
          <span class="achievement-number">{achievement.number}</span>
          <h3>{achievement.title}</h3>
          <p class="achievement-attribution">{achievement.attribution}</p>
          <p class="achievement-qualification">{achievement.qualification}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
