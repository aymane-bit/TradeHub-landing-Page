---
import { hero } from '../content/site';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-grid container">
    <div class="hero-copy reveal">
      <p class="eyebrow">
        <span aria-hidden="true"></span>
        {hero.eyebrow}
      </p>
      <h1 id="hero-title">{hero.headline}</h1>
      <p class="hero-introduction">{hero.introduction}</p>
      <div class="hero-actions">
        <a class="button button-signal" href={hero.primaryTarget}>
          {hero.primaryAction}
          <span aria-hidden="true">↗</span>
        </a>
        <a class="button button-ghost-dark" href={hero.secondaryTarget}>
          {hero.secondaryAction}
          <span aria-hidden="true">↓</span>
        </a>
      </div>
      <ul class="trust-line" aria-label="Product highlights">
        {hero.trustItems.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>

    <figure class="hero-product reveal" aria-labelledby="hero-product-caption">
      <div class="product-orbit product-orbit-one" aria-hidden="true"></div>
      <div class="product-orbit product-orbit-two" aria-hidden="true"></div>
      <div class="hero-product-bar">
        <span>
          <i aria-hidden="true"></i>
          {hero.visualLabel}
        </span>
        <span>TradeHub / Overview</span>
      </div>
      <a
        class="hero-product-link"
        href="/product/market-overview.webp"
        aria-label={hero.fullSizeLabel}
      >
        <img
          src="/product/market-overview.webp"
          width="1024"
          height="987"
          alt={hero.visualAlt}
          decoding="async"
          fetchpriority="high"
        />
      </a>
      <figcaption id="hero-product-caption">
        <span>{hero.visualCaption}</span>
        <a href="/product/market-overview.webp">
          View full size <span aria-hidden="true">↗</span>
        </a>
      </figcaption>
    </figure>
  </div>
</section>
