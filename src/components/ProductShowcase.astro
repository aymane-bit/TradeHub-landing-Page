---
import { productShowcase } from '../content/site';
---

<section
  class="story-section product-showcase"
  id="showcase"
  aria-labelledby="showcase-title"
>
  <div class="container">
    <header class="showcase-introduction">
      <div class="section-introduction">
        <p class="section-eyebrow">{productShowcase.eyebrow}</p>
        <h2 id="showcase-title">{productShowcase.headline}</h2>
        <p class="section-lead">{productShowcase.introduction}</p>
      </div>
      <p class="showcase-qualification">{productShowcase.qualification}</p>
    </header>

    <div class="showcase-stories">
      {productShowcase.stories.map((story) => (
        <article class="showcase-story">
          <div class="showcase-copy">
            <p class="showcase-label">
              <span class="item-number" aria-hidden="true">
                {story.number}
              </span>
              <span>{story.label}</span>
            </p>
            <h3>{story.title}</h3>
            <p>{story.description}</p>
          </div>

          <figure class="showcase-media">
            <div class="showcase-frame">
              <picture>
                <source
                  type="image/webp"
                  srcset={story.image.srcset}
                  sizes="(min-width: 80rem) 47rem, (min-width: 64rem) 58vw, calc(100vw - 2.5rem)"
                />
                <img
                  class="showcase-image"
                  src={story.image.src}
                  width={story.image.width}
                  height={story.image.height}
                  alt={story.image.alt}
                  loading="lazy"
                  decoding="async"
                />
              </picture>
            </div>
            <figcaption class="showcase-caption">
              <span>{story.image.caption}</span>
              <a class="image-hint" href={story.image.src}>
                {story.image.fullSizeLabel}
              </a>
            </figcaption>
          </figure>
        </article>
      ))}
    </div>
  </div>
</section>
